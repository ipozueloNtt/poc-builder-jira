  "usage": {
    "primaryIntent": "Permitir seleccion de opciones con una representacion rica de contenido y estados accesibles.",
    "useCases": [
      "Seleccion de alternativas de producto o configuracion en layout tipo grid.",
      "Patrones de eleccion unica (radio) o multiple (checkbox) con contenido extendido.",
      "Listados de tarjetas con jerarquia visual (tag, overline, heading, subtitle)."
    ],
    "antiPatterns": [
      {
        "scenario": "Usar card-selectable sin texto identificable (heading o aria-label).",
        "reason": "Compromete la accesibilidad y la comprension del criterio de seleccion.",
        "alternative": "Definir heading-text o aria-label descriptivo por opcion."
      },
      {
        "scenario": "Mezclar seleccion multiple en un contexto que exige eleccion exclusiva.",
        "reason": "Genera ambiguedad en la validacion del formulario y en el feedback al usuario.",
        "alternative": "Usar type='single' o encapsular en ath-card-selectable-group sin multiple."
      }
    ]
  },
