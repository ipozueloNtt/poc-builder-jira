{
  "component": {
    "tag": "ath-input-text",
    "name": "Input Text",
    "type": "input",
    "category": "atoms",
    "status": "stable",
    "version": "v1",
    "since": "2.0.0",
    "filePath": "src/components/input-text/input-text.tsx",
    "encapsulation": "shadow",
    "description": "Campo de entrada de texto para formularios con soporte de label, ayuda, validacion, contador y variantes de tipo.",
    "links": {
      "storybook": "https://aletehia.vercel.app/?path=/docs/componentes-input-text--docs",
      "storybookDocsJson": "https://aletehia.vercel.app/docs.json",
