    }
  },
  "usage": {
    "primaryIntent": "Capturar texto corto en formularios con soporte de estados y feedback.",
    "useCases": [
      "Campos de texto, email, telefono, URL y busqueda.",
      "Formularios con validacion inline y mensajes de ayuda.",
      "Escenarios con contador de caracteres y limpieza de valor."
    ],
    "antiPatterns": [
      {
        "scenario": "Usar input-text para texto multilinea",
        "reason": "No esta optimizado para bloques largos de texto.",
        "alternative": "Usar ath-input-textarea."
      }
    ]
  },
  "variants": {
    "type": {
      "options": [
        "text",
        "search",
        "url",
        "email",
        "tel"
      ],
